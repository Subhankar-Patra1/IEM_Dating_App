generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DATABASE_URL")
  relationMode      = "prisma"
}

model User {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String?           @unique @db.VarChar(255)
  phone              String?           @unique @db.VarChar(20)
  name               String            @db.VarChar(255)
  passwordHash       String            @map("password_hash") @db.VarChar(255)
  college            String?           @db.VarChar(255)
  department         String?           @db.VarChar(100)
  year               Int?
  yearOfStudy        Int?              @map("year_of_study")
  birthday           DateTime?
  age                Int?
  gender             String?           @db.VarChar(50)
  showGender         Boolean           @default(true) @map("show_gender")
  orientation        String[]          @default([])
  showOrientation    Boolean           @default(true) @map("show_orientation")
  seeking            String?           @db.VarChar(50)
  distancePreference Int?              @default(100) @map("distance_preference")
  preferences        Json?
  isVerified         Boolean           @default(false) @map("is_verified")
  isActive           Boolean           @default(true) @map("is_active")
  role               String            @default("user") @db.VarChar(20)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at")
  attendanceMood     String?           @map("attendance_mood") @db.VarChar(100)
  campus             String?           @db.VarChar(255)
  height             Int?
  clubs              String[]          @default([])
  degree             String?           @db.VarChar(255)
  hangoutSpots       String[]          @default([]) @map("hangout_spots")
  isHosteller        Boolean?          @map("is_hosteller")
  avatarUrl          String?           @map("avatar_url") @db.VarChar(500)
  profileVideoUrl    String?           @map("profile_video_url") @db.VarChar(500)
  videoPreviewUrl    String?           @map("video_preview_url") @db.VarChar(500)
  lastActiveAt       DateTime?         @map("last_active_at")
  locationArea       String?           @map("location_area") @db.VarChar(255)
  matchPreferences   MatchPreference[]
  matchesAsUser1     Match[]           @relation("MatchUser1")
  matchesAsUser2     Match[]           @relation("MatchUser2")
  messages           Message[]
  photos             ProfilePhoto[]
  reportsReceived    SafetyReport[]    @relation("ReportedUser")
  reportsFiled       SafetyReport[]    @relation("Reporter")
  swipesMade         Swipe[]           @relation("SwipesMade")
  swipesReceived     Swipe[]           @relation("SwipesReceived")
  sessions           UserSession[]
  userScore          UserScore?
  blocksGiven        UserBlock[]       @relation("BlockerUser")
  blocksReceived     UserBlock[]       @relation("BlockedUser")
  notifications      Notification[]
  deviceTokens       DeviceToken[]

  @@index([email])
  @@index([department])
  @@index([year])
  @@index([lastActiveAt])
  @@index([locationArea])
  @@index([department, year])
  @@index([gender, seeking])
  @@index([campus, isHosteller])
  @@index([isVerified, lastActiveAt])
  @@map("users")
}

model ProfilePhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  photoUrl  String   @map("photo_url") @db.VarChar(500)
  isPrimary Boolean  @default(false) @map("is_primary")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_photos")
}

model Match {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user1Id            String            @map("user1_id") @db.Uuid
  user2Id            String            @map("user2_id") @db.Uuid
  compatibilityScore Float?            @map("compatibility_score")
  createdAt          DateTime          @default(now()) @map("created_at")
  expiresAt          DateTime?         @map("expires_at")
  status             String            @default("active") @db.VarChar(20)
  chatSessions       ChatSession[]
  preferences        MatchPreference[]
  user1              User              @relation("MatchUser1", fields: [user1Id], references: [id])
  user2              User              @relation("MatchUser2", fields: [user2Id], references: [id])
  messages           Message[]
  safetyReports      SafetyReport[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("matches")
}

model MatchPreference {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId     String   @map("match_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  maxAge      Int?     @map("max_age")
  minYear     Int?     @map("min_year")
  maxYear     Int?     @map("max_year")
  departments String[]
  createdAt   DateTime @default(now()) @map("created_at")
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("match_preferences")
}

model Message {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId   String    @map("match_id") @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  content   String
  photoUrl  String?   @map("photo_url") @db.VarChar(500)
  mediaKeys String[]  @default([]) @map("media_keys")
  sentAt    DateTime  @default(now()) @map("sent_at")
  readAt    DateTime? @map("read_at")
  isDeleted Boolean   @default(false) @map("is_deleted")
  hiddenBy  String[]  @default([]) @map("hidden_by")
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id])

  @@index([matchId])
  @@index([sentAt])
  @@map("messages")
}

model ChatSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId       String    @map("match_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at")
  unreadCount   Int       @default(0) @map("unread_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}

model SafetyReport {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String   @map("reporter_id") @db.Uuid
  reportedUserId String   @map("reported_user_id") @db.Uuid
  matchId        String?  @map("match_id") @db.Uuid
  reason         String?  @db.VarChar(100)
  description    String?
  status         String   @default("pending") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  match          Match?   @relation(fields: [matchId], references: [id])
  reportedUser   User     @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reporter       User     @relation("Reporter", fields: [reporterId], references: [id])

  @@index([reportedUserId])
  @@index([reportedUserId, status])
  @@map("safety_reports")
}

model UserSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenJti   String   @unique @map("token_jti") @db.VarChar(255)
  expiresAt  DateTime @map("expires_at")
  deviceInfo Json?    @map("device_info")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Swipe {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  swiperId  String   @map("swiper_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  action    String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  swiper    User     @relation("SwipesMade", fields: [swiperId], references: [id], onDelete: Cascade)
  target    User     @relation("SwipesReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetId])
  @@index([swiperId])
  @@index([targetId])
  @@map("swipes")
}

model UserScore {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  totalSwipesOut      Int      @default(0) @map("total_swipes_out")
  totalRightSwipes    Int      @default(0) @map("total_right_swipes")
  totalSwipesReceived Int      @default(0) @map("total_swipes_received")
  totalLikesReceived  Int      @default(0) @map("total_likes_received")
  messagesSent        Int      @default(0) @map("messages_sent")
  messagesReceived    Int      @default(0) @map("messages_received")
  messagesReplied     Int      @default(0) @map("messages_replied")
  desirabilityScore   Float    @default(50.0) @map("desirability_score")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([desirabilityScore])
  @@map("user_scores")
}

model UserScoreHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  scoreType String   @default("desirability") @map("score_type") @db.VarChar(50)
  oldValue  Float    @map("old_value")
  newValue  Float    @map("new_value")
  reason    String?  @db.VarChar(100)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([scoreType, createdAt])
  @@map("user_score_history")
}

model AlgorithmConfig {
  key       String   @id @db.VarChar(100)
  value     Float
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("algorithm_config")
}

model UserBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  body      String
  data      Json?
  actionUrl String?  @map("action_url") @db.VarChar(500)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model AnalyticsEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(50)
  eventData Json     @map("event_data")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}

model DeviceToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @db.VarChar(500)
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@map("device_tokens")
}
