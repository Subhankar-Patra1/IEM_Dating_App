{
  "name": "iem-dating-app",
  "version": "1.0.0",
  "private": true,
  "description": "IEM Dating App Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "dev:api": "npm run dev --workspace=@iem-dating/api",
    "dev:mobile": "npm run start --workspace=@iem-dating/mobile",
    "services:up": "docker-compose up -d",
    "services:down": "docker-compose down"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
